# qt_extra_flags.cmake — Qt6 交叉编译时跳过缺失的第三方依赖检测 (2026-08-14)
# 用于 CV186AH 设备上无 OpenGL ES / Vulkan 的 sysroot 时
set(WrapOpenGL_FOUND TRUE CACHE BOOL "" FORCE)
set(WrapVulkanHeaders_FOUND TRUE CACHE BOOL "" FORCE)
set(XKB_FOUND TRUE CACHE BOOL "" FORCE)
set(XKB_VERSION "0.5.0" CACHE STRING "" FORCE)
set(FREETYPE_FOUND TRUE CACHE BOOL "" FORCE)
set(FONTCONFIG_FOUND TRUE CACHE BOOL "" FORCE)
set(GLIB_FOUND TRUE CACHE BOOL "" FORCE)
set(GLIBC_FOUND TRUE CACHE BOOL "" FORCE)
set(ICU_FOUND TRUE CACHE BOOL "" FORCE)
set(ZLIB_FOUND TRUE CACHE BOOL "" FORCE)
set(PNG_FOUND TRUE CACHE BOOL "" FORCE)
set(JPEG_FOUND TRUE CACHE BOOL "" FORCE)
set(SQLite_FOUND TRUE CACHE BOOL "" FORCE)
set(OpenGL_FOUND FALSE CACHE BOOL "" FORCE)
set(EGL_FOUND TRUE CACHE BOOL "" FORCE)